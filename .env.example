# Adres van het Helios-platform: de knoppen Inloggen en Aanmelden linken hierheen.
# Lokaal is dat de Docker-app; op de server het echte adres, bijv. https://app.jouwdomein.nl
NEXT_PUBLIC_APP_URL=http://localhost:8800

# Adres van deze website zelf (sitemap, robots.txt en de voorbeeldweergave van gedeelde links).
NEXT_PUBLIC_SITE_URL=https://helioscareer.nl

# Meet- en advertentiediensten: laden pas na toestemming in de cookiemelding. Leeg = uit; staan ze allemaal leeg, dan
# verschijnt er ook geen cookiemelding. Google Analytics 4 (G-… of de Tag Manager-container GTM-…), Google Ads (AW-…), Meta-pixel en LinkedIn Insight Tag
# (allebei een getal).
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
